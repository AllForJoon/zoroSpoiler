{
  "manifest_version": 3,
  "name": "ZoroSpoiler",
  "version": "0.1.0",
  "description": "유튜브에서 아직 보지 않은 장면을 밝히는 댓글을 가립니다.",
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["comments.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
